<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the setup checklist: tick, label, where to fix it, and Sửa. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/manubook_check_mark"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/manubook_check_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            android:id="@+id/manubook_check_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            style="@style/AppTheme.HelperText" />
    </LinearLayout>

    <Button
        android:id="@+id/manubook_check_fix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/manubook_fix"
        style="?android:attr/borderlessButtonStyle" />
</LinearLayout>
