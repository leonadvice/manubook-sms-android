<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system trust store only, no pinning (android review F10). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
