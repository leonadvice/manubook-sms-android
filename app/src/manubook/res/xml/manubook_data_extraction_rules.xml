<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone: the key and the beat token stay out of cloud
     backups and device-to-device transfers (android review F9). A new phone is
     set up with a new code. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
