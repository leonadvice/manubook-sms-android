    <issue id="UnspecifiedRegisterReceiverFlag">
        <ignore path="src/main/java/tech/bogomolov/incomingsmsgateway/ForwardingConfigDialog.java" />
    </issue>
    <!-- A Play Store hint for ChromeOS; the app is not distributed on Play. -->
    <issue id="PermissionImpliesUnsupportedChromeOsHardware">
        <ignore path="src/main/AndroidManifest.xml" />
    </issue>
</lint>
